#!/usr/bin/env bash
# notif-clear: close every desktop notification (the popup and the ones in GNOME's list).
# GNOME has no "clear all" command, but it numbers notifications 1, 2, 3... and closes any of them
# by number over D-Bus. Send one silent notification to learn the newest number, then close that
# one and the 500 before it. (Apps using GNOME's own notification API instead of notify-send's
# aren't reached this way; the Clear button in the list still removes those.)
set -u

newest=$(notify-send -p -u low -t 1 -h boolean:transient:true " " 2>/dev/null) || exit 0
for ((id = newest; id > 0 && id > newest - 500; id--)); do
    gdbus call --session --dest org.freedesktop.Notifications \
        --object-path /org/freedesktop/Notifications \
        --method org.freedesktop.Notifications.CloseNotification "$id" >/dev/null 2>&1
done
