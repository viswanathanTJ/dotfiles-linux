[Unit]
Description=ydotool daemon (virtual keyboard for CopyQ paste on Wayland)

[Service]
# Runs as you: /dev/uinput is writable by the input group. Keyboard only, no virtual mouse.
ExecStart=/usr/bin/ydotoold --mouse-off --socket-path=%t/.ydotool_socket
Restart=on-failure

[Install]
WantedBy=default.target
