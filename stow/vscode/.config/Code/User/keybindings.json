// Place your key bindings in this file to override the defaults
[
    { "key": "ctrl+shift+'", "command": "workbench.action.toggleMaximizedPanel" },
    // Mac Control+J = Join Lines. Toshy sends Caps+J and physical Left Ctrl+J as Super+J (meta+j) in VS Code;
    // Alt+J (Cmd+J) stays Ctrl+J = toggle panel, like Cmd+J on a Mac
    { "key": "meta+j", "command": "editor.action.joinLines", "when": "editorTextFocus && !editorReadonly" },
    // vscode-neovim: remove its Ctrl+W <key> window chords, so Ctrl+W closes the tab in
    // Markdown preview and other non-text views (they made VS Code wait for a second key)
    { "key": "ctrl+w q", "command": "-workbench.action.closeActiveEditor" },
    { "key": "ctrl+w ctrl+w", "command": "-workbench.action.focusNextGroup" },
    { "key": "ctrl+w up", "command": "-workbench.action.navigateUp" },
    { "key": "ctrl+w k", "command": "-workbench.action.navigateUp" },
    { "key": "ctrl+w down", "command": "-workbench.action.navigateDown" },
    { "key": "ctrl+w j", "command": "-workbench.action.navigateDown" },
    { "key": "ctrl+w left", "command": "-workbench.action.navigateLeft" },
    { "key": "ctrl+w h", "command": "-workbench.action.navigateLeft" },
    { "key": "ctrl+w right", "command": "-workbench.action.navigateRight" },
    { "key": "ctrl+w l", "command": "-workbench.action.navigateRight" },
    { "key": "ctrl+w =", "command": "-workbench.action.evenEditorWidths" },
    { "key": "ctrl+w shift+-", "command": "-workbench.action.toggleEditorWidths" },
    { "key": "ctrl+w shift+.", "command": "-workbench.action.increaseViewWidth" },
    { "key": "ctrl+w shift+,", "command": "-workbench.action.decreaseViewWidth" },
    { "key": "ctrl+w shift+=", "command": "-workbench.action.increaseViewHeight" },
    { "key": "ctrl+w -", "command": "-workbench.action.decreaseViewHeight" },
    { "key": "ctrl+w s", "command": "-workbench.action.splitEditorDown" },
    { "key": "ctrl+w v", "command": "-workbench.action.splitEditorRight" }
]
