# Machine-only Run or Raise shortcuts. reload-shortcuts copies this to
# ~/.config/run-or-raise/shortcuts.local.conf when that file is missing; that file is NOT tracked.
# Shared shortcuts are in keyboard/run-or-raise-shortcuts.conf.

# Ctrl+Alt+Super+X (Alt+Caps+X): Brave. Exact wm_class, so Brave web apps aren't matched.
<Control><Alt><Super>x,gtk-launch brave-browser,/^[Bb]rave-browser$/,
# Ctrl+Alt+Super+M (Alt+Caps+M): YouTube Music (Brave web app; its window class carries the app id)
<Control><Alt><Super>m,gtk-launch brave-cinhimbnkkaeohfgghhklpknlkffjgod-viswa2k,/cinhimbnkkaeohfgghhklpknlkffjgod/,

# On a Chrome + Teams machine use these instead:
# <Control><Alt><Super>x,gtk-launch google-chrome,/^[Gg]oogle-chrome$/,
# <Control><Alt><Super>m,gtk-launch teams-for-linux,/^teams-for-linux$/,
